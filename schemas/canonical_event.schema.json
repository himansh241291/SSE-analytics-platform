{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/himansh241291/SSE-analytics-platform/blob/main/schemas/canonical_event.schema.json",
  "title": "SSE Canonical Security Event",
  "type": "object",
  "additionalProperties": true,
  "required": ["event_id", "event_time", "source_log_type", "event_type"],
  "properties": {
    "event_id": {"type": "string"},
    "event_time": {"type": "string", "format": "date-time"},
    "ingested_at": {"type": "string", "format": "date-time"},
    "tenant_id": {"type": ["string", "null"]},
    "source_log_type": {"type": "string", "enum": ["audit", "dlp", "dns", "firewall", "proxy", "rc_event", "ztna"]},
    "event_type": {"type": "string"},
    "action": {"type": ["string", "null"]},
    "severity": {"type": ["string", "null"]},
    "user_id": {"type": ["string", "null"]},
    "user_email": {"type": ["string", "null"]},
    "identity_type": {"type": ["string", "null"]},
    "device_id": {"type": ["string", "null"]},
    "source_ip": {"type": ["string", "null"]},
    "destination_ip": {"type": ["string", "null"]},
    "destination_domain": {"type": ["string", "null"]},
    "url": {"type": ["string", "null"]},
    "source_port": {"type": ["integer", "null"]},
    "destination_port": {"type": ["integer", "null"]},
    "protocol": {"type": ["string", "null"]},
    "application": {"type": ["string", "null"]},
    "private_resource_id": {"type": ["string", "null"]},
    "private_resource_group": {"type": ["string", "null"]},
    "connector_id": {"type": ["string", "null"]},
    "policy_id": {"type": ["string", "null"]},
    "ruleset_id": {"type": ["string", "null"]},
    "rule_id": {"type": ["string", "null"]},
    "bytes_sent": {"type": ["integer", "null"]},
    "bytes_received": {"type": ["integer", "null"]},
    "packets_sent": {"type": ["integer", "null"]},
    "packets_received": {"type": ["integer", "null"]},
    "category": {"type": ["string", "null"]},
    "threat": {"type": ["string", "null"]},
    "malware_name": {"type": ["string", "null"]},
    "av_disposition": {"type": ["string", "null"]},
    "dlp_status": {"type": ["string", "null"]},
    "dlp_rule": {"type": ["string", "null"]},
    "file_name": {"type": ["string", "null"]},
    "file_sha256": {"type": ["string", "null"]},
    "event_correlation_id": {"type": ["string", "null"]},
    "raw_event": {"type": "object"}
  }
}
